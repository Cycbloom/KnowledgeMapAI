# Knowledge Map Development Environment Configuration Example
# 本地开发环境配置示例 - 复制此文件为 .env.development 并填入实际值
# 使用 Docker 本地 Supabase

# ===========================================
# Supabase Configuration (Local Development)
# ===========================================
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Supabase JWT Secret for local JWT verification (Supabase CLI default)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ===========================================
# Database Connection (Direct PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ===========================================
# AI Provider Configuration
# ===========================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VITE_VOLCENGINE_API_KEY=your_volcengine_api_key_here
ALIYUN_API_KEY=your_aliyun_api_key_here
VITE_ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===========================================
# Cache Configuration
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ===========================================
# Rate Limit Configuration
# ===========================================
DISABLE_RATE_LIMIT=true
