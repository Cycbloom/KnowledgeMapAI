# Knowledge Map Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Environment Setup Guide
# ===========================================
# 开发环境: 复制此文件为 .env.development 并使用本地 Supabase 配置
# 生产环境: 复制此文件为 .env.production 并使用云端 Supabase 配置
#
# 本地开发环境默认配置:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# 启动本地数据库: npm run db:local:start
# 停止本地数据库: npm run db:local:stop
# 重置本地数据库: npm run db:local:reset

# ===========================================
# Supabase Configuration (Required)
# ===========================================
# Your Supabase project URL (from Project Settings > API)
VITE_SUPABASE_URL=your_supabase_project_url

# IMPORTANT: Use the 'anon' public key here, NOT the 'service_role' key!
# The anon key is safe to expose in frontend code (from Project Settings > API > Project API keys)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANT: Keep the service_role key SECRET! Never expose in frontend code!
# This key is only for server-side operations (from Project Settings > API > Project API keys)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase JWT Secret for local JWT verification in requireAuth middleware
# Verifies Supabase-issued JWTs without network calls (distinct from app JWT_SECRET)
# Local dev default (from Supabase CLI): super-secret-jwt-token-with-at-least-32-characters-long
# Production: retrieve from Supabase Dashboard > Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ===========================================
# Cache Configuration (Optional)
# Cache backend selection. Currently only 'memory' is supported.
# Future: set to 'redis' for multi-instance Web deployments.
# ===========================================
CACHE_BACKEND=memory

# ===========================================
# Rate Limit Configuration (Optional)
# Rate limit store selection. Currently only 'memory' is supported.
# Future: set to 'redis' for multi-instance Web deployments.
# ===========================================
RATE_LIMIT_STORE=memory

# ===========================================
# AI Provider Configuration
# At least one AI provider is required for AI features
# ===========================================

# Deepseek Configuration
DEEPSEEK_API_KEY=your_deepseek_key
# Mobile client API key (VITE_ prefix required for client-side access)
VITE_DEEPSEEK_API_KEY=your_deepseek_key

# Volcengine Configuration
VOLCENGINE_API_KEY=your_volcengine_key
# Mobile client API key (VITE_ prefix required for client-side access)
VITE_VOLCENGINE_API_KEY=your_volcengine_key

# Aliyun Configuration
ALIYUN_API_KEY=your_aliyun_key
# Mobile client API key (VITE_ prefix required for client-side access)
VITE_ALIYUN_API_KEY=your_aliyun_key
# Optional: Custom base URL for Aliyun MaaS (default: https://dashscope.aliyuncs.com/compatible-mode/v1)
ALIYUN_BASE_URL=

# ===========================================
# Server Configuration (Optional)
# ===========================================
PORT=3001
# Set this to your production URL when deploying to Vercel
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ===========================================
# Mobile API Configuration (Optional)
# ===========================================
# API base URL for mobile apps (Capacitor)
# Leave empty for web development (uses Vite proxy)
# Example: https://your-app.vercel.app/api
VITE_API_BASE_URL=

# Feature flag to use Supabase direct connection on mobile
# Set to 'true' to fallback to Supabase direct connection
# Default: false (uses unified backend API)
VITE_MOBILE_USE_SUPABASE_DIRECT=false

# ===========================================
# Test Configuration (Optional)
# Used for E2E testing
# ===========================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test123456

# ===========================================
# Concept Aggregation Configuration (Optional)
# ===========================================
# Similarity threshold for merging concepts (0.0 - 1.0)
# Default: 0.85
CONCEPT_MERGE_THRESHOLD=0.85

# Stricter threshold for batch-internal concept merging
# Default: 0.92
CONCEPT_BATCH_MERGE_THRESHOLD=0.92

# Threshold for confirming fuzzy title matches via embedding
# Default: 0.75
CONCEPT_FUZZY_TITLE_THRESHOLD=0.75

# ===========================================
# Rate Limit Configuration (Optional)
# Set to true to disable rate limiting (for testing)
# ===========================================
DISABLE_RATE_LIMIT=true
