VITE_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Configuration
# Note: Providers and Base URLs are hardcoded in api/services/ai/config.ts

# Deepseek Configuration
DEEPSEEK_API_KEY=your_deepseek_key

# Volcengine Configuration
VOLCENGINE_API_KEY=your_volcengine_key

# Aliyun Configuration
ALIYUN_API_KEY=your_aliyun_key

# Model Configuration
# Note: Please configure specific model names (e.g., deepseek-chat, doubao-pro-32k, qwen-turbo) in the Frontend Settings (Profile).
# Do not configure models here to avoid conflicts.

# Cache Configuration
REDIS_URL=redis://localhost:6379

# TTS Service Configuration
TTS_SERVICE_URL=http://localhost:8001

# Test Account Configuration
TEST_USER_EMAIL=your_test_email@example.com
TEST_USER_PASSWORD=your_test_password
