# Knowledge Map Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Supabase Configuration (Required)
# ===========================================
# Your Supabase project URL (from Project Settings > API)
VITE_SUPABASE_URL=your_supabase_project_url

# IMPORTANT: Use the 'anon' public key here, NOT the 'service_role' key!
# The anon key is safe to expose in frontend code (from Project Settings > API > Project API keys)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANT: Keep the service_role key SECRET! Never expose in frontend code!
# This key is only for server-side operations (from Project Settings > API > Project API keys)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# AI Provider Configuration
# At least one AI provider is required for AI features
# ===========================================

# Deepseek Configuration
DEEPSEEK_API_KEY=your_deepseek_key
# Mobile client API key (VITE_ prefix required for client-side access)
VITE_DEEPSEEK_API_KEY=your_deepseek_key

# Volcengine Configuration
VOLCENGINE_API_KEY=your_volcengine_key
# Mobile client API key (VITE_ prefix required for client-side access)
VITE_VOLCENGINE_API_KEY=your_volcengine_key

# Aliyun Configuration
ALIYUN_API_KEY=your_aliyun_key
# Mobile client API key (VITE_ prefix required for client-side access)
VITE_ALIYUN_API_KEY=your_aliyun_key

# ===========================================
# Cache Configuration (Optional)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Server Configuration (Optional)
# ===========================================
PORT=3001
# Set this to your production URL when deploying to Vercel
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ===========================================
# TTS Service Configuration (Optional)
# ===========================================
TTS_SERVICE_URL=http://localhost:8001

# ===========================================
# Test Configuration (Optional)
# Used for E2E testing
# ===========================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test123456

# ===========================================
# Rate Limit Configuration (Optional)
# Set to true to disable rate limiting (for testing)
# ===========================================
DISABLE_RATE_LIMIT=true
