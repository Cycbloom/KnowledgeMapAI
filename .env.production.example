# KnowledgeMap Production Environment Configuration Example
# Copy to .env.production and fill in real values. DO NOT COMMIT the real file.

# ===========================================
# Supabase (Cloud / Self-hosted) - Required
# ===========================================
VITE_SUPABASE_URL=https://supabase.cycbloom.cn
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (API / Electron bundled API). NEVER expose in client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ===========================================
# API base URL used by clients
# Web/Mobile point here; empty = same-origin /api/v1
# ===========================================
VITE_API_BASE_URL=https://api.cycbloom.cn/api/v1

# ===========================================
# Server
# ===========================================
PORT=3001
FRONTEND_URL=https://app.cycbloom.cn
NODE_ENV=production

# ===========================================
# Encryption key for securing API keys stored in DB.
# Keep fixed after first use (changing breaks decryption).
# ===========================================
ENCRYPTION_KEY=your-encryption-key-here

# ===========================================
# Cache / Rate limit / Event bus (single instance -> memory)
# ===========================================
CACHE_BACKEND=memory
RATE_LIMIT_STORE=memory
EVENT_BUS_BACKEND=memory

# ===========================================
# AI Providers (optional; can also configure in-app Settings)
# ===========================================
DEEPSEEK_API_KEY=
VITE_DEEPSEEK_API_KEY=
VOLCENGINE_API_KEY=
VITE_VOLCENGINE_API_KEY=
ALIYUN_API_KEY=
VITE_ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
