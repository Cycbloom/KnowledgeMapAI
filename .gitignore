# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-electron
release
*.local

# TypeScript and ESLint cache
node_modules/.cache/
node_modules/.tmp/
.eslintcache

# Python cache (scripts)
__pycache__/
*.py[cod]

# 本地原生模块缓存（Node ABI 的 better-sqlite3 副本，供 vitest 使用）
.toolcache/

# TypeScript build info files (project references incremental cache)
*.tsbuildinfo

# TypeScript 编译产物 (api 目录)
api/**/*.js
api/**/*.js.map

# TypeScript 编译产物 (src/types 目录)
src/types/*.js
src/types/*.js.map

# TypeScript 编译产物 (shared/types 目录)
shared/types/*.js
shared/types/*.js.map

# 开发产物
dev-dist/

# vite-plugin-pwa 在 swDest 配置下偶发输出到项目根的产物（未被引用）
/pwa-sw.js
/workbox-*.js

# 本地数据库
data/*.db
data/*.db-shm
data/*.db-wal

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# TRAE IDE working directory (planning specs, session memory)
.trae/
# WorkBuddy session memory
.workbuddy/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vite

# Environment files with secrets
.env
.env.local
.env.development
.env.production
.env.vercel
.vercel.env
.env.*.local
.jwt_secret
.env.check

# Seed runtime artifacts (live bcrypt login for demo owner — never commit)
.seed-owner-credentials.json

# Dev owner-credentials auto-synced by the app during login (never commit —
# contains a live owner password used only by AI/Playwright debug scripts)
.dev-owner-credentials.json

# One-off debug diffs (local troubleshooting artifacts — never commit)
__diffs__/

# Vercel
.vercel/

backups/

# Playwright test outputs
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Test output snapshots and one-off debug scripts
test-output*.txt
tmp_*.js
tmp_screenshots/

# Vitest coverage output
coverage/

# Electron
*.blockmap

# Vercel CLI auto-generated files
.env.check
.env.vercel

# Package manager leftovers
--fix/
# KnowledgeMap × DSH harness 集成：运行时数据不入库（源码保留）
.deepseek-harness/memory/
.deepseek-harness/knowledgemap/*.json
.deepseek-harness/knowledgemap/export-*.json
.deepseek-harness/knowledgemap/*.js
