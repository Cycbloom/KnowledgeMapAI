# Ignore all files in api directory except index.ts
# This prevents Vercel from treating each file as a separate Serverless Function

# Ignore routes directory (handled by Express app)
api/routes/**
api/routes/**/*

# Ignore services directory
api/services/**
api/services/**/*

# Ignore middleware directory
api/middleware/**

# Ignore schemas directory
api/schemas/**

# Ignore config directory
api/config/**

# Ignore constants directory
api/constants/**

# Ignore docs directory
api/docs/**

# Ignore jobs directory
api/jobs/**

# Ignore utils directory
api/utils/**

# Ignore types directory
api/types/**

# Ignore tests
api/__tests__/**

# Ignore assets
api/assets/**

# Standard ignores
node_modules
.git
.env.local
.env.*.local
dist
