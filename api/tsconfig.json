// Editor/IDE 支持配置，构建使用根目录下的 tsconfig.api.json
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "..",
    "types": ["node", "express"],
    "typeRoots": ["../node_modules/@types", "./types"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "__tests__/**"]
}
