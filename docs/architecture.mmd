flowchart TB
    %% ================= 客户端形态 =================
    subgraph CLIENTS["🎯 客户端形态"]
        direction LR
        WEB["🌐 Web / PWA（Vite 构建）"]
        DESK["🖥️ Electron 桌面（Win / macOS / Linux）"]
        MOB["📱 Android 移动端（Capacitor WebView）"]
    end

    subgraph RENDERER["🧩 前端渲染层 src/ · React 18 + TS + Vite 6"]
        direction TB
        ENTRY["入口 main.tsx / App.tsx<br/>路由 · 懒加载 · 错误边界"]
        PAGES["pages/ 30+ 页面<br/>Dashboard · GraphEditor · Scheduler · Study · Quiz · Settings"]
        COMP["components/ 37 功能目录<br/>Graph · Scheduler · Learning · Notes · RAGChat · common · Layout"]
        HOOKS["hooks/ 18 领域<br/>graphEditor · graphAI · scheduler · study · quiz · mutations"]
        STORE["store/ Zustand<br/>useStore · useThemeStore · useTimerStore · useNotificationsStore"]
        SVC["services/ 服务层<br/>api(contracts · modules) · kernel · sync · console · mobile · timer"]
        SPECIAL["three/ 3D · workers/ WebWorker<br/>i18n/ 中英双语 · utils/ · config/ · constants/ · types/"]
    end

    subgraph SHARED["🔗 共享层 shared/（跨端复用）"]
        direction TB
        STYPES["types/ 40+ 类型<br/>graph-* · scheduler-* · ipc · events · database.generated"]
        KERNEL["kernel/ 插件内核<br/>PluginLifecycleBase"]
        SYNC["sync/ 离线同步算法<br/>conflictDetector · conflictResolver · operationMerger"]
        SCONST["constants/ · utils/<br/>masteryThresholds · taskDefaults · markdownParser"]
    end

    subgraph ELECTRON["🖥️ Electron 主进程 electron/"]
        direction TB
        MAIN["main.ts + preload.ts<br/>窗口 · 菜单 · 托盘 · contextBridge"]
        IPC["ipc/ 12 组通道<br/>db · sync · update · window · dialog · power · shell · badge"]
        EDB["db/ 本地库 better-sqlite3<br/>schema.ts · migrations/001_initial.ts"]
        ESYNC["sync/ syncEngine.ts<br/>本地 ↔ 云端同步"]
        EUTILS["utils/ windowManager · trayManager<br/>powerManager · appMenu · logger"]
    end

    subgraph API["⚙️ 后端 API 层 api/ · Node.js + Express"]
        direction TB
        BOOT["app.ts · server.ts · supabase.ts<br/>Swagger 文档 · 路由挂载"]
        ROUTES["routes/ 24 路由模块<br/>graphNodes · ai · rag · tasks · calendar · plugins · search"]
        MID["middleware/ 8 中间件<br/>auth · csrf · rateLimiter · errorHandler · validate · ownership"]
        ASVC["services/ achievementService · asyncTaskService"]
        AJOBS["jobs/ 后台任务<br/>autoBackupScheduler · taskProcessor"]
        ADB["database/ transactionExecutor"]
    end

    subgraph DATA["🗄️ 数据层"]
        SUPABASE["Supabase（PostgreSQL）<br/>47 migrations · pgvector 向量检索<br/>RLS 行级安全 · Auth 认证"]
        SQLITE["better-sqlite3<br/>Electron 本地离线缓存"]
    end

    subgraph EXT["🌍 外部服务"]
        AI["AI 提供商（OpenAI SDK）<br/>Deepseek · 火山引擎 · 阿里云<br/>文本生成 · 向量嵌入"]
        GH["GitHub Releases<br/>electron-updater 自动更新"]
    end

    subgraph INFRA["🛠️ 工程化 & 基础设施"]
        direction TB
        BUILD["构建链 Vite 6 + electron-builder<br/>+ Capacitor + PWA"]
        CI["CI/CD GitHub Actions<br/>ci.yml · release.yml"]
        TEST["测试 Vitest 单元 · Playwright e2e<br/>MSW · SQL 测试"]
        DEVOPS["Docker Compose · Supabase CLI<br/>scripts/ 工具链 · nodemon"]
    end

