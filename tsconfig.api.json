{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./dist/api",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "types": ["node", "express"],
    "typeRoots": ["./node_modules/@types", "./api/types"]
  },
  "include": ["api/**/*"],
  "exclude": ["api/__tests__", "**/*.test.ts"],
  "references": [
    { "path": "./tsconfig.shared.json" }
  ]
}
