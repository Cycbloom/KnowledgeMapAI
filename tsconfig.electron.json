{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist-electron",
    "rootDirs": ["./electron", "./api", "./shared"],
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": false
  },
  "include": ["electron/**/*", "api/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist-electron", "src", "api/__tests__", "**/*.test.ts"]
}
