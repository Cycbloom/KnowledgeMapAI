{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./dist/src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.src.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts"],
  "references": [
    { "path": "./tsconfig.shared.json" }
  ]
}
